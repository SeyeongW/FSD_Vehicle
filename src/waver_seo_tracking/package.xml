<?xml version="1.0"?>
<package format="3">
  <name>waver_seo_tracking</name>
  <version>0.1.0</version>
  <description>Gazebo-only SEO branch tracking adapters for Waver bird patrol integration.</description>
  <maintainer email="you@example.com">waver</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
