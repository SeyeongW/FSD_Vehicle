Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Mid360 PointCloud
      Topic:
        Value: /mid360_PointCloud2
      Size (Pixels): 2
      Style: Points
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Filtered ROI Points
      Topic:
        Value: /filtered_points
      Size (Pixels): 4
      Style: Points
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Cluster Markers
      Topic:
        Value: /cluster_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Spatial Debug Markers
      Topic:
        Value: /waver/spatial_debug_markers
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: LiDAR Target Pose
      Topic:
        Value: /waver/lidar_target_pose_odom
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Object Mission Goal
      Topic:
        Value: /waver/object_mission_goal
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Active Nav Goal
      Topic:
        Value: /waver/active_nav_goal
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.1
      Target Frame: odom
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1400
