<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="world">
      <static>1</static>
      <include>
        <uri>model://world</uri>
      </include>
    </model>

    <!-- Fixed Livox Mid-360 x3 for coordinate fusion prototype -->
    <model name="fixed_lidar_1">
      <static>1</static>
      <pose>-6 -6 1.8 0 0 0.7854</pose>
      <link name="lidar1_link">
        <visual name="lidar1_visual">
          <geometry>
            <box><size>0.1 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar1" type="ray">
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <plugin name="lidar1_plugin" filename="libros2_livox.so">
            <ray>
              <scan>
                <horizontal>
                  <samples>100</samples>
                  <resolution>1</resolution>
                  <min_angle>0</min_angle>
                  <max_angle>6.2831852</max_angle>
                </horizontal>
                <vertical>
                  <samples>360</samples>
                  <resolution>1</resolution>
                  <min_angle>-0.126017</min_angle>
                  <max_angle>0.96378</max_angle>
                </vertical>
              </scan>
              <range>
                <min>0.1</min>
                <max>200.0</max>
                <resolution>0.002</resolution>
              </range>
              <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </ray>
            <visualize>false</visualize>
            <samples>40000</samples>
            <downsample>1</downsample>
            <csv_file_name>/home/seo/ros2_ws/ugv_ws/install/ros2_livox_simulation/share/ros2_livox_simulation/scan_mode/mid360.csv</csv_file_name>
            <topic>lidar1</topic>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="fixed_lidar_2">
      <static>1</static>
      <pose>6 -6 1.8 0 0 2.356</pose>
      <link name="lidar2_link">
        <visual name="lidar2_visual">
          <geometry>
            <box><size>0.1 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar2" type="ray">
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <plugin name="lidar2_plugin" filename="libros2_livox.so">
            <ray>
              <scan>
                <horizontal>
                  <samples>100</samples>
                  <resolution>1</resolution>
                  <min_angle>0</min_angle>
                  <max_angle>6.2831852</max_angle>
                </horizontal>
                <vertical>
                  <samples>360</samples>
                  <resolution>1</resolution>
                  <min_angle>-0.126017</min_angle>
                  <max_angle>0.96378</max_angle>
                </vertical>
              </scan>
              <range>
                <min>0.1</min>
                <max>200.0</max>
                <resolution>0.002</resolution>
              </range>
              <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </ray>
            <visualize>false</visualize>
            <samples>40000</samples>
            <downsample>1</downsample>
            <csv_file_name>/home/seo/ros2_ws/ugv_ws/install/ros2_livox_simulation/share/ros2_livox_simulation/scan_mode/mid360.csv</csv_file_name>
            <topic>lidar2</topic>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="fixed_lidar_3">
      <static>1</static>
      <pose>0 6 1.8 0 0 -1.5708</pose>
      <link name="lidar3_link">
        <visual name="lidar3_visual">
          <geometry>
            <box><size>0.1 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar3" type="ray">
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <plugin name="lidar3_plugin" filename="libros2_livox.so">
            <ray>
              <scan>
                <horizontal>
                  <samples>100</samples>
                  <resolution>1</resolution>
                  <min_angle>0</min_angle>
                  <max_angle>6.2831852</max_angle>
                </horizontal>
                <vertical>
                  <samples>360</samples>
                  <resolution>1</resolution>
                  <min_angle>-0.126017</min_angle>
                  <max_angle>0.96378</max_angle>
                </vertical>
              </scan>
              <range>
                <min>0.1</min>
                <max>200.0</max>
                <resolution>0.002</resolution>
              </range>
              <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </ray>
            <visualize>false</visualize>
            <samples>40000</samples>
            <downsample>1</downsample>
            <csv_file_name>/home/seo/ros2_ws/ugv_ws/install/ros2_livox_simulation/share/ros2_livox_simulation/scan_mode/mid360.csv</csv_file_name>
            <topic>lidar3</topic>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>