<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="ugv_mou_mountain_200m">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.6189</latitude_deg>
      <longitude_deg>-122.3750</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <physics name="ode_mountain_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_contacts>20</max_contacts>
      <ode>
        <solver><type>quick</type><iters>80</iters><sor>1.30</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.20</erp><contact_max_correcting_vel>0.2</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <scene>
      <ambient>0.50 0.55 0.58 1</ambient>
      <background>0.58 0.72 0.88 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>124 -136 82 0 0.60 2.36</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <light name="mountain_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>-70 -80 120 0 0 0</pose>
      <diffuse>0.96 0.91 0.78 1</diffuse>
      <specular>0.22 0.20 0.18 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.45 0.22 -0.86</direction>
    </light>
    <include>
      <uri>model://ugv_mou_terrain</uri>
      <name>ugv_mou_terrain</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://ugv_mou_forest_obstacles</uri>
      <name>ugv_mou_forest_obstacles</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
