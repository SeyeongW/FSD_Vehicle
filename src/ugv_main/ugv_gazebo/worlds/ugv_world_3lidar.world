<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="Simple_20m_Rover_Bird_Runway">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <light name="sun" type="directional">
      <!-- 그림자를 끔 — YOLO로 새를 인식해야 하는데 그림자 진 쪽이 어둡게
           나와서 인식률이 떨어지는 문제가 있었음 (실사 사실감보다 검출
           안정성이 우선). -->
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.68 0.83 1.0 1</background>
      <shadows>false</shadows>
    </scene>

    <model name="map_floor">
      <static>true</static>
      <link name="link">
        <collision name="floor_collision">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>20 20 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>1</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="grass_south">
          <pose>0 -6.6667 0.001 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 6.6667 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.34 0.08 1</ambient>
            <diffuse>0.17 0.48 0.12 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>

        <visual name="grass_north">
          <pose>0 6.6667 0.001 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 6.6667 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.34 0.08 1</ambient>
            <diffuse>0.17 0.48 0.12 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>

        <visual name="grass_south_mow_1">
          <pose>0 -8.2667 0.003 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 0.6 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.39 0.09 1</ambient>
            <diffuse>0.20 0.54 0.14 1</diffuse>
          </material>
        </visual>

        <visual name="grass_south_mow_2">
          <pose>0 -5.0667 0.003 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 0.6 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.39 0.09 1</ambient>
            <diffuse>0.20 0.54 0.14 1</diffuse>
          </material>
        </visual>

        <visual name="grass_north_mow_1">
          <pose>0 5.0667 0.003 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 0.6 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.39 0.09 1</ambient>
            <diffuse>0.20 0.54 0.14 1</diffuse>
          </material>
        </visual>

        <visual name="grass_north_mow_2">
          <pose>0 8.2667 0.003 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 0.6 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.39 0.09 1</ambient>
            <diffuse>0.20 0.54 0.14 1</diffuse>
          </material>
        </visual>

        <visual name="runway_asphalt">
          <pose>0 0 0.004 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>20 6.6667 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.035 0.035 0.035 1</ambient>
            <diffuse>0.055 0.055 0.055 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>

        <visual name="runway_edge_north">
          <pose>0 3.1333 0.008 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>18.9333 0.1067 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="runway_edge_south">
          <pose>0 -3.1333 0.008 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>18.9333 0.1067 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="runway_center_dash_1">
          <pose>-6.2667 0 0.010 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>2.4 0.16 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="runway_center_dash_2">
          <pose>0 0 0.010 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>2.4 0.16 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="runway_center_dash_3">
          <pose>6.2667 0 0.010 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>2.4 0.16 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="runway_threshold_west">
          <pose>-9 0 0.010 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>0.16 5.6 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="runway_threshold_east">
          <pose>9 0 0.010 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>0.16 5.6 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 10.1667 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>20.6667 0.3333 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20.6667 0.3333 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.49 0.46 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -10.1667 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>20.6667 0.3333 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20.6667 0.3333 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.49 0.46 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10.1667 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3333 20.6667 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3333 20.6667 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.49 0.46 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10.1667 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3333 20.6667 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3333 20.6667 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.49 0.46 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fixed Livox Mid-360 x2 at runway edges (hackathon 3-LiDAR fusion prototype) -->
    <model name="fixed_lidar_1">
      <static>1</static>
      <pose>-9.3333 0 1.8 0 0 0</pose>
      <link name="lidar1_link">
        <visual name="lidar1_visual">
          <geometry>
            <box><size>0.1 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar1" type="ray">
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <plugin name="lidar1_plugin" filename="libros2_livox.so">
            <ray>
              <scan>
                <horizontal>
                  <samples>100</samples>
                  <resolution>1</resolution>
                  <min_angle>0</min_angle>
                  <max_angle>6.2831852</max_angle>
                </horizontal>
                <vertical>
                  <samples>360</samples>
                  <resolution>1</resolution>
                  <min_angle>-0.126017</min_angle>
                  <max_angle>0.96378</max_angle>
                </vertical>
              </scan>
              <range>
                <min>0.1</min>
                <max>70.0</max>
                <resolution>0.002</resolution>
              </range>
              <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </ray>
            <visualize>false</visualize>
            <samples>12000</samples>
            <downsample>1</downsample>
            <csv_file_name>/home/seo/ros2_ws/ugv_ws/install/ros2_livox_simulation/share/ros2_livox_simulation/scan_mode/mid360.csv</csv_file_name>
            <topic>lidar1</topic>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="fixed_lidar_2">
      <static>1</static>
      <pose>9.3333 0 1.8 0 0 3.14159</pose>
      <link name="lidar2_link">
        <visual name="lidar2_visual">
          <geometry>
            <box><size>0.1 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar2" type="ray">
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <plugin name="lidar2_plugin" filename="libros2_livox.so">
            <ray>
              <scan>
                <horizontal>
                  <samples>100</samples>
                  <resolution>1</resolution>
                  <min_angle>0</min_angle>
                  <max_angle>6.2831852</max_angle>
                </horizontal>
                <vertical>
                  <samples>360</samples>
                  <resolution>1</resolution>
                  <min_angle>-0.126017</min_angle>
                  <max_angle>0.96378</max_angle>
                </vertical>
              </scan>
              <range>
                <min>0.1</min>
                <max>70.0</max>
                <resolution>0.002</resolution>
              </range>
              <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </ray>
            <visualize>false</visualize>
            <samples>12000</samples>
            <downsample>1</downsample>
            <csv_file_name>/home/seo/ros2_ws/ugv_ws/install/ros2_livox_simulation/share/ros2_livox_simulation/scan_mode/mid360.csv</csv_file_name>
            <topic>lidar2</topic>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 짐벌 카메라를 북쪽 벽(wall_north, y=10.1667, 안쪽 면 y=10.0) 안쪽에 직접
         부착 (관제탑 구조물 제거, 벽걸이형으로 변경). world_fix 조인트(parent=world)가
         스폰이 아니라 월드 로드 시점에만 제대로 붙기 때문에 <include>로 넣는다.
         yaw 1.5708(방 중앙/남쪽 방향)은 관제탑일 때 확인된 값 그대로 유지. -->
    <include>
      <uri>model://gimbal_classic</uri>
      <pose>0 9.85 1.8 0 0 1.5708</pose>
    </include>

  </world>
</sdf>