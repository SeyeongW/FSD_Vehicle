# ==============================================
# ROS2 Workspace - Git Ignore
# ==============================================

# 빌드 아티팩트 (절대 커밋하지 않음)
build/
install/
log/
.colcon/

# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.Python

# 에디터
.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.bak

# OS
.DS_Store
Thumbs.db

# 대용량 이미지 파일 (images/ 폴더)
images/

# 압축 파일
*.zip
*.tar.gz

# 지도 파일 (런타임 생성)
*.pgm
*.yaml
map_points.txt

# ROS2 패키지의 launch/config/waypoint YAML은 소스에 포함해야 함
!src/**/*.yaml
!src/**/*.yml

# Root-level Waver real-vehicle profile/schema YAML files are source contracts.
!config/real_profiles/
!config/real_profiles/*.yaml
!config/waver_base_feedback_schema.yaml

# Gazebo 임시 파일
.gazebo/
.tmp/

# ROS/Gazebo experiment outputs (논문 원본 rosbag/대용량 결과는 런타임 생성)
bags/
**/bags/
**/rosbag/
**/rosbag*/
*.bag
*.sqlite3
experiments_result/
experiment_results/
experiments_result_compact/
waver_experiments/
waver_experiments*/
*.db3
*.mcap
*.log

# Generated quality/iteration reports
reports/quality_gate/*
!reports/quality_gate/.gitkeep
reports/agent_iterations/*
!reports/agent_iterations/.gitkeep

# Generated dataset / analysis artifacts
**/metrics/
**/plots/
**/annotations/
**/images/
**/screenshots/

# Local/private env overrides. The repository intentionally tracks non-secret
# defaults in .env and config/waver_field_env for clone-to-run operation.
.env.local
*.env.local
.env.private
*.private
config/waver_field_env.local
.waver_field_env.local
id_rsa
id_ed25519
*.pem
*.key
