# ==============================================
# ROS2 Workspace - Git Ignore
# ==============================================

# 빌드 아티팩트 (절대 커밋하지 않음)
build/
install/
log/
.colcon/

# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.Python

# 에디터
.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.bak

# OS
.DS_Store
Thumbs.db

# 대용량 이미지 파일 (images/ 폴더)
images/

# 압축 파일
*.zip
*.tar.gz

# 지도 파일 (런타임 생성)
*.pgm
*.yaml
map_points.txt

# ROS2 패키지의 launch/config/waypoint YAML은 소스에 포함해야 함
!src/**/*.yaml
!src/**/*.yml

# Gazebo 임시 파일
.gazebo/
.tmp/

# ROS/Gazebo experiment outputs (논문 원본 rosbag/대용량 결과는 런타임 생성)
bags/
experiments_result/
waver_experiments/
waver_experiments*/
**/rosbag/
*.db3
*.mcap
